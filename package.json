{
  "name": "emuman",
  "version": "1.1.0",
  "description": "Web-based KVM/QEMU manager with VNC, SSH and serial consoles",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "check": "node --check server/index.js",
    "start:api": "node server/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "fastify": "^5.6.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@novnc/novnc": "^1.7.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.2.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
